# MAX AI - Environment Configuration

# Server Port (default: 3000)
PORT=3000

# Google Gemini API Key (Required for AI generation, RAG, and multimodal extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (MongoDB Atlas or local MongoDB instance)
# Example Atlas: mongodb+srv://username:password@cluster0.mongodb.net/max_ai?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/max_ai
# (If omitted, MAX AI automatically uses its resilient local memory fallback store)
MONGODB_URI=mongodb://127.0.0.1:27017/max_ai
